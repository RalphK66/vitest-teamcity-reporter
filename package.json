{
  "name": "@ralphk66/vitest-teamcity-reporter",
  "version": "1.0.3",
  "description": "TeamCity reporter for Vitest",
  "keywords": [
    "jetbrains",
    "reporter",
    "teamcity",
    "test",
    "vitest"
  ],
  "homepage": "https://github.com/RalphK66/vitest-teamcity-reporter#readme",
  "bugs": {
    "url": "https://github.com/RalphK66/vitest-teamcity-reporter/issues"
  },
  "license": "MIT",
  "author": "RalphK66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RalphK66/vitest-teamcity-reporter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.ts && tsc --emitDeclarationOnly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src test",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.74.0",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "engines": {
    "node": "24"
  }
}
